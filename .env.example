# The hosted Surfpool mainnet fork â€” the "devnet" in the hostname is a legacy
# naming artifact, not public Solana devnet. Real mainnet mints, real Kamino/
# Jupiter deployments. See TOOLS_CATALOGUE.md Â§0/Â§1.
SOLANA_RPC_URL=https://rpc-devnet.solana.vanna.finance
SOLANA_WS_URL=wss://rpc-devnet.solana.vanna.finance
SOLANA_CLUSTER_LABEL=surfpool-fork

# The ONLY hardcoded on-chain entry point â€” there is no registry to resolve
# this from. Verified against declare_id!/Anchor.toml and the app's own
# default (TOOLS_CATALOGUE.md Â§1, Â§6.1 item 9).
VANNA_PROGRAM_ID=H37YVBG3eGtz89ofd7iDLc2PJgn12778392XeU2QJcGC

# Fork price preparation (the app's price keeper; no Hermes this release). dev-fork = refresh prices before every
# health-checked write; pyth-pull = no refresh (real cluster, external keepers).
# Hermes / production Pyth is not used in this release.
ORACLE_MODE=dev-fork
# keeper = the app's price keeper (owner decision; default). cheatcode = this server's
# own surfnet_setAccount adapter â€” only for a program version the keeper doesn't cover.
PRICE_REFRESH_SOURCE=keeper
# The vanna-credit-backend app's host (not the RPC host): /api/prices/refresh and
# /api/faucet. devnet.solana.vanna.finance is the old stack's app, not this one.
# Unauthenticated on the app side today; sent as a Bearer token once hardened.
PRICE_KEEPER_URL=https://test.solana.vanna.finance
PRICE_KEEPER_SECRET=
# cheatcode source only: Kamino's Scope account is copied from mainnet onto the fork.
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter (wallet_swap / margin_swap / vault quotes and swap-instruction builds).
# Set = the keyed api.jup.ag endpoint with this key's quota. Unset on a fork =
# the app's own proxy (JUPITER_PROXY_URL, default {PERPS_HELPER_URL or
# PRICE_KEEPER_URL}/api/jupiter), which calls Jupiter with the app's server key,
# like the app's vault actions. Unset off a fork = keyless lite-api.jup.ag
# (0.5 req/s shared cap). A 429 is retried once.
JUPITER_API_KEY=
JUPITER_PROXY_URL=
# Titan swap API key (https://portal.api.titan.exchange). Without it swaps use Jupiter only.
TITAN_API_KEY=
# Or a QuickNode Solana endpoint URL with the Titan Swap add-on (the token is in the URL; leave TITAN_API_KEY empty).
TITAN_API_URL=
# Fork-safe DEX allowlist â€” oracle-driven and concentrated-liquidity pools
# can reject/drift on a cloned fork; override only if you know why.
JUPITER_FORK_DEXES=Raydium,Raydium CLMM,Raydium CP,Orca V2,Meteora DLMM,Whirlpool

# Protocol address lookup table(s) for margin swaps (comma-separated). Create once with
# `python scripts/create_protocol_lookup_table.py`; without it, margin swaps into JupSOL/JitoSOL (and swaps on
# accounts holding several assets) can exceed Solana's 1232-byte limit. A missing table is skipped, never fatal.
# Staging fork (created 2026-10-02): 3VEqRdeCsA1Xx5GDEwBQoAaBn4mPzEYuqmVUPfbJwsVG
PROTOCOL_LOOKUP_TABLES=

# The liquidation line (1.10) is the program's own constant, not a setting; the product floor is MIN_HEALTH_FACTOR.

# Feature gates â€” both default OFF. Fork tools are never exposed to the Copilot;
# liquidation is not user-facing in the app either.
ENABLE_FORK_TOOLS=false
ENABLE_LIQUIDATION_BUILDER=false

# MCP transport: stdio (local dev / Claude Desktop) or streamable-http (hosted)
MCP_TRANSPORT=stdio
PORT=8000

# OAuth 2.1 resource-server auth for streamable-http (mcp_server/auth.py).
# Required for any hosted deployment (the hosted service is behind Cloud Run IAM too); off for stdio / local dev.
# Hosted values come from a WorkOS M2M application, not an AuthKit API key.
# See COPILOT_ARCHITECTURE.md Â§7 and Â§11.
AUTH_ENABLED=false
OAUTH_ISSUER=
OAUTH_JWKS_URI=
OAUTH_AUDIENCE=
# Extra accepted audiences, comma-separated (e.g. the Copilot app's M2M credential).
OAUTH_M2M_AUDIENCE=
# Allowed browser Origins, comma-separated. Empty = no Origin restriction.
OAUTH_ALLOWED_ORIGINS=
# Public base URL behind TLS/proxy, used in discovery metadata and WWW-Authenticate.
EXTERNAL_BASE_URL=
# Client IDs trusted as first-party (granted vanna:write without a scope claim).
FIRST_PARTY_CLIENT_IDS=

# Per-caller token bucket on POST /mcp. Writes cost 10, heavy reads 5, other reads 1.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REFILL_PER_SEC=8
RATE_LIMIT_BURST=24
# Proxies that append to X-Forwarded-For (client IP for unauthenticated rate limiting).
# 0 = ignore the header (safe default); Cloud Run direct = 1; behind an HTTPS load balancer = 2.
TRUSTED_PROXY_HOPS=0

LOG_LEVEL=INFO



# ---------------------------------------------------------------------------
# Public connector (wallet-as-login OAuth) — ONLY for the separate public service, never the Copilot's.
# See docs/CONNECTING_CLIENTS.md §3 and MCP_CONNECTOR_PLAN.md. The process refuses to start unless these are
# consistent (AUTH_ENABLED=true, https EXTERNAL_BASE_URL, https OAUTH_CONSENT_URL, a signing key,
# FIRST_PARTY_CLIENT_IDS empty, ENABLE_FORK_TOOLS off).
# ---------------------------------------------------------------------------
PUBLIC_MODE=false
# The Vanna app's wallet-connect consent page (UI only; the MCP makes every decision).
OAUTH_CONSENT_URL=
# ES256 (P-256) private key in PEM, from Secret Manager. Signs 15-minute access tokens; it cannot move funds.
OAUTH_SIGNING_KEY_PEM=
# Previous public keys (PEM, concatenated) still published at /.well-known/jwks.json after a rotation.
OAUTH_RETIRED_PUBLIC_KEYS_PEM=
# Local development only: sign with a throwaway key (every token dies on restart).
OAUTH_ALLOW_EPHEMERAL_KEY=false
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_CODE_TTL_SECONDS=60
OAUTH_PENDING_TTL_SECONDS=600
OAUTH_SIWS_TTL_SECONDS=120
# Dynamic client registration caps: per source IP per hour, and across the service per day.
OAUTH_DCR_PER_IP_PER_HOUR=10
OAUTH_DCR_GLOBAL_PER_DAY=2000
# Where OAuth / plan / safety state lives: memory (one process) or firestore (shared by every instance; required on Cloud Run
# in PUBLIC_MODE). See docs/DEPLOY_PUBLIC.md.
STATE_STORE=memory
FIRESTORE_PROJECT=
FIRESTORE_COLLECTION=mcp_state

# ---------------------------------------------------------------------------
# MCP client parity (Claude, Cursor, ...): the Copilot's guardrails, planner and signing pages. See
# docs/CONNECTING_CLIENTS.md. `python scripts/run_local.py` sets the first four for you.
# ---------------------------------------------------------------------------
# Enforce the 1.15 floor, USD limits and build rate on every direct write (always on in public mode).
SAFETY_LAYER=false
# Serve the pages where the user's wallet approves a plan and signs; writes then return a link. Needs an HTTP transport
# (stdio runs serve them on a background thread at 127.0.0.1:PORT).
ENABLE_SIGN_LINKS=false
# Origin the user's browser reaches the pages at; defaults to EXTERNAL_BASE_URL, else http://127.0.0.1:PORT.
SIGN_BASE_URL=
# vanna_wallet action=faucet: tops up the caller's wallet on the test fork (fork cluster only).
ENABLE_TEST_FAUCET=false
FAUCET_REQUESTS_PER_WALLET_PER_DAY=3
MIN_HEALTH_FACTOR=1.15
MAX_ACTION_USD=5000
MAX_DAILY_USD=25000
WRITE_RATE_PER_MINUTE=6
PLAN_APPROVAL_TTL_SECONDS=300
PLAN_RUN_WINDOW_SECONDS=1800
MAX_PLAN_STEPS=8
SIGN_INTENT_TTL_SECONDS=900
