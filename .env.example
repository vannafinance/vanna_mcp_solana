# The public devnet endpoint is heavily rate-limited (airdrops especially).
# Use a dedicated devnet endpoint from an RPC provider for reliable use.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# The ONLY hardcoded on-chain entry point — there is no registry to resolve
# this from. See VANNA_SOLANA_MCP_REQUIREMENTS.md Part A #1 (Backend-Solana repo).
VANNA_PROGRAM_ID=BZ812nUv4Qhr2p1JVgmoJGjYTGk1brAXckyhFSCNH3Zg
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
WSOL_MINT=So11111111111111111111111111111111111111112

# Pyth Hermes requires authentication as of 2026-08-26.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
PYTH_FEED_ID_SOL=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
PYTH_FEED_ID_USDC=eaa020c61cc479712813461ce153894a96a6c00b21ed0cfc2798d1f9a9e9c94a

LIQUIDATION_THRESHOLD=1.1

# MCP transport: stdio (local dev / Claude Desktop) or streamable-http (hosted)
MCP_TRANSPORT=stdio
PORT=8000

LOG_LEVEL=INFO

# Sign Service (zero-custody signing delegate) — unconfigured until
# VANNA_SOLANA_MCP_REQUIREMENTS.md Part A #3 is answered.
SIGN_SERVICE_URL=
SIGN_SERVICE_SECRET=
S2S_AUTH_MODE=shared_secret
